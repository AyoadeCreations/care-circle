{
  "name": "care-circle",
  "version": "1.0.0",
  "description": "MCP-powered caregiver coordination assistant — Amazon Build Ship Shape 2026 Hackathon",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "start:unified": "node dist/server/unified.js",
    "dev:mcp": "node --watch dist/mcp/index.js",
    "dev:web": "node --watch dist/server/index.js",
    "dev": "tsc && concurrently \"npm run dev:mcp\" \"npm run dev:web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "seed": "node dist/db/seed.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "13.0.3",
    "express": "4.21.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.0",
    "@types/node": "22.15.21",
    "concurrently": "9.1.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
