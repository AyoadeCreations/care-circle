# Care Circle — Environment Variables
# Copy this file to .env and fill in values before running.
# Never commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────
# For local development: use a local file
# For Vercel/production: use a Turso database URL + auth token
#   1. Create a free account at https://app.turso.tech
#   2. Create a database: turso db create care-circle
#   3. Get the URL: turso db show care-circle --url
#   4. Get a token: turso db tokens create care-circle
TURSO_DATABASE_URL=file:./data/care-circle.db
TURSO_AUTH_TOKEN=

# ── Server ─────────────────────────────────────────────────────────────────
# Port for the web application (local dev only — Vercel sets this automatically)
PORT=3000

# Port for the MCP server (two-process local dev mode only)
MCP_PORT=3001

# URL for the MCP server endpoint.
# In unified mode (Vercel/Render): http://localhost:3000/mcp (or your deployed URL)
# In two-process mode: http://127.0.0.1:3001/mcp
MCP_URL=http://127.0.0.1:3001/mcp

# Set to "production" for production deployments
NODE_ENV=development

# Optional: allowed CORS origins for the API (comma-separated)
# Leave blank to allow all origins in development
# ALLOWED_ORIGINS=https://yourdomain.com
