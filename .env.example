# Care Circle — Environment Variables
# Copy this file to .env and fill in values before running.
# Never commit .env to source control.

# Port for the web application and API server
PORT=3000

# Port for the MCP server (used in two-process local dev mode only)
MCP_PORT=3001

# URL for the MCP server endpoint.
# In two-process mode: http://127.0.0.1:3001/mcp
# In unified mode: http://localhost:3000/mcp (or your deployed URL)
# MCP_URL=http://127.0.0.1:3001/mcp

# Absolute or relative path to the SQLite database file.
# The data/ directory is gitignored.
DB_PATH=./data/care-circle.db

# Set to "production" for production deployments
NODE_ENV=development

# Optional: allowed CORS origins for the API (comma-separated)
# Leave blank to allow all origins in development
# ALLOWED_ORIGINS=https://yourdomain.com

# Optional: a shared secret for internal API calls between web server and MCP server.
# Not required for local development — use it when deploying both servers publicly.
# INTERNAL_API_SECRET=
